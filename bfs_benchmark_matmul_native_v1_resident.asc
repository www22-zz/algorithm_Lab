#include "benchmark_parallel.hpp"
#include "benchmark_graph.hpp"
#include "acl/acl.h"
#include "aclnnop/aclnn_matmul.h"
#include "kernel_operator.h"
#include <algorithm>
#include <chrono>
#include <cstdint>
#include <cstdlib>
#include <iomanip>
#include <iostream>
#include <string>
#include <vector>

using namespace std;

constexpr int MAX_N = benchmark::max_n;
constexpr int POST_TILE = 32;
constexpr int CPU_REPEATS = 10;
constexpr int NPU_REPEATS = 5;

// KEEP_DTYPE: FP32 inputs/output, no requested precision reduction.
constexpr int8_t CUBE_MATH_TYPE = 0;

#define ACL_CHECK(call)                                                  \
    do {                                                                 \
        auto ret_ = (call);                                           \
        if (ret_ != 0) {                                              \
            cerr << "Failed: " << #call << ", code=" << ret_ << endl; \
            exit(EXIT_FAILURE);                                          \
        }                                                                \
    } while (0)

// Matmul's internal parallelism is selected by ACLNN, not by POST_TILE.
// This separate vector kernel assigns disjoint target ranges to blocks.
__vector__ __global__ void bfs_matmul_post(
    __gm__ float* y, __gm__ int32_t* distance, __gm__ float* next_frontier,
    int32_t n, int32_t level)
{
    AscendC::InitSocState();

    const int32_t base = block_idx * POST_TILE;
    if (base >= n) return;

    const int32_t valid = (n - base < POST_TILE) ? n - base : POST_TILE;

    AscendC::GlobalTensor<float> yg, next_gm;
    AscendC::GlobalTensor<int32_t> distance_gm;
    yg.SetGlobalBuffer(y + base, valid);
    distance_gm.SetGlobalBuffer(distance + base, valid);
    next_gm.SetGlobalBuffer(next_frontier + base, valid);

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ub_allocator;
    auto yl = ub_allocator.Alloc<float, POST_TILE>();
    auto distance_local = ub_allocator.Alloc<int32_t, POST_TILE>();
    auto next_local = ub_allocator.Alloc<float, POST_TILE>();

    AscendC::DataCopy(yl, yg, valid);
    AscendC::DataCopy(distance_local, distance_gm, valid);
    AscendC::PipeBarrier<PIPE_ALL>();

    for (int32_t i = 0; i < valid; ++i) {
        const bool found = yl.GetValue(i) > 0.0f && distance_local.GetValue(i) == -1;
        next_local.SetValue(i, found ? 1.0f : 0.0f);
        if (found) distance_local.SetValue(i, level + 1);
    }

    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::DataCopy(distance_gm, distance_local, valid);
    AscendC::DataCopy(next_gm, next_local, valid);
    AscendC::PipeBarrier<PIPE_ALL>();
}

static double elapsed_ms(chrono::steady_clock::time_point start,
                         chrono::steady_clock::time_point end)
{
    return chrono::duration<double, milli>(end - start).count();
}

// Same graph generator as the original benchmark; A[u*n+v] means u -> v.
// Full dense numeric multiplication: no frontier-zero skipping, early exit,
// visited-target skipping, segment reduction, or sparse list conversion.
static vector<int32_t> bfs_cpu_dense(const vector<float>& adj, int n, int threads = 1)
{
    // 图已经是float32，直接读取；不复制整张图。
    vector<float> frontier(n, 0), next_frontier(n), y(n);
    vector<int32_t> distance(n, -1);
    distance[0] = 0;
    frontier[0] = 1;

    int level = 0;
    while (true) {
        fill(y.begin(), y.end(), 0.0f);
        benchmark::parallel_ranges(n, threads, [&](int begin, int end) {
            for (int u = 0; u < n; ++u)
                for (int v = begin; v < end; ++v)
                    y[v] += frontier[u] * adj[static_cast<size_t>(u) * n + v];
        });

        bool changed = false;
        for (int v = 0; v < n; ++v) {
            bool found = y[v] > 0 && distance[v] == -1;
            next_frontier[v] = found ? 1.0f : 0.0f;
            if (found) {
                distance[v] = level + 1;
                changed = true;
            }
        }

        if (!changed) break;
        frontier.swap(next_frontier);

        if (++level >= n) {
            cerr << "CPU level limit\n";
            exit(2);
        }
    }

    return distance;
}

struct MatmulBuffers {
    float *d_adj = nullptr, *d_front_a = nullptr, *d_front_b = nullptr, *y = nullptr;
    int32_t* d_distance = nullptr;
    void* workspace = nullptr;
    uint64_t workspace_capacity = 0;

    void allocate(int n) {
        ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&d_adj),
                              size_t(n) * n * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST));
        ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&d_front_a),
                              n * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST));
        ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&d_front_b),
                              n * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST));
        ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&y),
                              n * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST));
        ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&d_distance),
                              n * sizeof(int32_t), ACL_MEM_MALLOC_HUGE_FIRST));
    }

    void reserve_workspace(uint64_t bytes) {
        if (bytes <= workspace_capacity) return;
        // Previous iteration was synchronized before any buffer can be freed.
        if (workspace) ACL_CHECK(aclrtFree(workspace));
        ACL_CHECK(aclrtMalloc(&workspace, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
        workspace_capacity = bytes;
    }

    void release() {
        for (void* p : {static_cast<void*>(d_adj), static_cast<void*>(d_front_a),
                        static_cast<void*>(d_front_b), static_cast<void*>(y),
                        static_cast<void*>(d_distance), workspace})
            if (p) ACL_CHECK(aclrtFree(p));

        d_adj = d_front_a = d_front_b = y = nullptr;
        d_distance = nullptr;
        workspace = nullptr;
        workspace_capacity = 0;
    }
};

static aclTensor* make_tensor(float* data, int64_t rows, int64_t cols)
{
    const int64_t dims[] = {rows, cols};
    const int64_t strides[] = {cols, 1};
    aclTensor* tensor = aclCreateTensor(dims, 2, ACL_FLOAT, strides, 0,
                                        ACL_FORMAT_ND, dims, 2, data);
    if (!tensor) {
        cerr << "aclCreateTensor failed\n";
        exit(2);
    }
    return tensor;
}

static void submit_matmul(aclTensor* f, aclTensor* a, aclTensor* y,
                          MatmulBuffers& buffers, aclrtStream stream)
{
    uint64_t bytes = 0;
    aclOpExecutor* executor = nullptr;

    // Query a fresh executor each layer; do not reuse a consumed executor.
    ACL_CHECK(aclnnMatmulGetWorkspaceSize(f, a, y, CUBE_MATH_TYPE, &bytes, &executor));
    buffers.reserve_workspace(bytes);
    ACL_CHECK(aclnnMatmul(buffers.workspace, bytes, executor, stream));
}

struct MatmulRun {
    vector<int32_t> distance;
    double kernel_launch_sync_ms = 0, end_to_end_ms = 0;
};

static MatmulRun bfs_npu_matmul(const vector<float>& adj, int n,
                                MatmulBuffers& buffers, aclrtStream stream)
{
    if (n < 64 || n > MAX_N || n % POST_TILE) {
        cerr << "Supported n: multiples of 32, 64..8192\n";
        exit(2);
    }

    MatmulRun result;
    result.distance.resize(n);
    (void)adj;  // 图已常驻 device（每个 n 只上传一次），本函数不再上传整图
    vector<float> host_frontier(n, 0), host_next(n, 0);
    vector<int32_t> host_distance(n, -1);
    host_frontier[0] = 1;
    host_distance[0] = 0;

    // 从这里开始 E2E 计时；图不参与本次计时（resident）。
    const auto e2e_start = chrono::steady_clock::now();
    const size_t vec_bytes = n * sizeof(float);
    ACL_CHECK(aclrtMemcpy(buffers.d_front_a, vec_bytes, host_frontier.data(), vec_bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMemcpy(buffers.d_distance, n * sizeof(int32_t), host_distance.data(),
                          n * sizeof(int32_t), ACL_MEMCPY_HOST_TO_DEVICE));

    aclTensor* at = make_tensor(buffers.d_adj, n, n);
    aclTensor* ft = make_tensor(buffers.d_front_a, 1, n);
    aclTensor* nt = make_tensor(buffers.d_front_b, 1, n);
    aclTensor* yt = make_tensor(buffers.y, 1, n);

    float* frontier_out = buffers.d_front_b;
    float* frontier_in = buffers.d_front_a;
    int level = 0;

    while (true) {
        const auto kernel_start = chrono::steady_clock::now();

        submit_matmul(ft, at, yt, buffers, stream);
        // Same stream guarantees Matmul completes before postprocessing reads y.
        bfs_matmul_post<<<static_cast<uint32_t>(n / POST_TILE), 0, stream>>>(
            buffers.y, buffers.d_distance, frontier_out, n, level);
        ACL_CHECK(aclrtSynchronizeStream(stream));

        result.kernel_launch_sync_ms += elapsed_ms(kernel_start, chrono::steady_clock::now());
        ACL_CHECK(aclrtMemcpy(host_next.data(), vec_bytes, frontier_out, vec_bytes, ACL_MEMCPY_DEVICE_TO_HOST));
        if (none_of(host_next.begin(), host_next.end(),
                    [](float value) { return value != 0; }))
            break;

        swap(frontier_in, frontier_out);
        swap(ft, nt);
        if (++level >= n) {
            cerr << "NPU level limit\n";
            exit(2);
        }
    }

    ACL_CHECK(aclDestroyTensor(at));
    ACL_CHECK(aclDestroyTensor(ft));
    ACL_CHECK(aclDestroyTensor(nt));
    ACL_CHECK(aclDestroyTensor(yt));
    ACL_CHECK(aclrtMemcpy(result.distance.data(), n * sizeof(int32_t), buffers.d_distance,
                          n * sizeof(int32_t), ACL_MEMCPY_DEVICE_TO_HOST));
    result.end_to_end_ms = elapsed_ms(e2e_start, chrono::steady_clock::now());
    return result;
}

int main(int argc, char**)
{
    if (argc != 1) {
        cerr << "Usage: bfs_benchmark_matmul_native\n";
        return 2;
    }

    const int cpu_threads = benchmark::cpu_threads();
    std::cout << "CPU threads=" << cpu_threads << '\n';
    cout << "Route: resident float32 graph + Matmul (ACLNN), CPU=full dense float32\n"
         << "Config: POST_TILE=32, MAX_N=8192, CUBE_MATH_TYPE=0, INPUT=float32-native, RESIDENT=1\n";

    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    ACL_CHECK(aclrtCreateStream(&stream));


    cout << fixed << setprecision(4);
    cout << "\n"
         << setw(6)  << "N"
         << setw(10) << "Edges"
         << setw(16) << "CPU-1T(ms)"
         << setw(16) << "CPU-MT(ms)"
         << setw(20) << "NPU-SubmitSync(ms)"
         << setw(16) << "NPU-E2E(ms)"
         << setw(16) << "CPU-1T/E2E"
         << setw(16) << "CPU-MT/E2E"
         << setw(10) << "Check"
         << "\n";
    cout << string(126, '-') << "\n";

    for (int n : benchmark::sizes) {
        auto adj = benchmark::generate_graph<float>(n);
        auto cpu_reference = bfs_cpu_dense(adj, n);

        const auto cpu_timing = benchmark::measure_cpu(n, cpu_threads, CPU_REPEATS, cpu_reference,
            [&](int threads) { return bfs_cpu_dense(adj, n, threads); });
        const double cpu_ms = cpu_timing.single_ms;
        const double cpu_mt_ms = cpu_timing.multi_ms;
        double submit = 0, e2e = 0;

        MatmulBuffers buffers;
        buffers.allocate(n);
        // 图只上传一次（计时外），之后常驻 device 供 warmup 和 5 次重复复用。
        ACL_CHECK(aclrtMemcpy(buffers.d_adj, size_t(n)*n*sizeof(float), adj.data(),
                              size_t(n)*n*sizeof(float), ACL_MEMCPY_HOST_TO_DEVICE));
        if (bfs_npu_matmul(adj, n, buffers, stream).distance != cpu_reference) return 3;
        for (int r = 0; r < NPU_REPEATS; ++r) {
            auto run = bfs_npu_matmul(adj, n, buffers, stream);
            if (run.distance != cpu_reference) return 3;
            submit += run.kernel_launch_sync_ms;
            e2e += run.end_to_end_ms;
        }

        submit /= NPU_REPEATS;
        e2e /= NPU_REPEATS;

        int64_t edges = 0;
        for (auto x : adj) edges += x;
        edges /= 2;

        cout << setw(6)  << n
             << setw(10) << edges
             << setw(16) << cpu_ms
             << setw(16) << cpu_mt_ms
             << setw(20) << submit
             << setw(16) << e2e
             << setw(16) << cpu_ms / e2e
             << setw(16) << cpu_mt_ms / e2e
             << setw(10) << "PASS"
             << "\n";
        cout << "       E2E(ms): CPU-1T=" << cpu_ms << ", CPU-MT=" << cpu_mt_ms << ", NPU-MatmulNative=" << e2e << '\n';

        buffers.release();
    }

    ACL_CHECK(aclrtDestroyStream(stream));
    ACL_CHECK(aclrtResetDevice(0));
    ACL_CHECK(aclFinalize());

    cout << "All BFS tests completed. All correctness checks passed.\n";
    return 0;
}
